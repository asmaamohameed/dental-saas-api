// Dental Clinic SaaS - Database Schema

Table tenants {
  id uuid [pk]
  name varchar [not null]
  subdomain varchar [unique, not null]
  locale varchar [not null, default: 'ar', note: 'ar = افتراضي, en = ثانوي']
  status varchar [not null, note: 'trial, active, suspended']
  created_at timestamp [default: `now()`]
}

Table subscriptions {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  plan_type varchar [not null]
  status varchar [not null, note: 'trial, active, expired']
  is_founding_member boolean [not null, default: false]
  start_date date
  end_date date
  marked_paid_at timestamp
  notes text
}

Table users {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  name varchar [not null]
  email varchar [unique, not null]
  phone varchar
  password_hash varchar [not null]
  role varchar [not null, note: 'owner, doctor, receptionist']
  locale varchar [note: 'null = يرث لغة العيادة الافتراضية']
  is_active boolean [not null, default: true]
  created_at timestamp [default: `now()`]
}

Table patients {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  full_name varchar [not null]
  phone varchar
  date_of_birth date
  gender varchar
  medical_history jsonb
  notes text
  created_at timestamp [default: `now()`]
}

Table appointments {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  patient_id uuid [not null, ref: > patients.id]
  doctor_id uuid [not null, ref: > users.id]
  created_by uuid [ref: > users.id]
  scheduled_at timestamp [not null]
  duration_minutes int
  status varchar [not null, note: 'scheduled, completed, cancelled, no_show']
  notes text
  created_at timestamp [default: `now()`]
}

Table tooth_records {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  patient_id uuid [not null, ref: > patients.id]
  appointment_id uuid [ref: > appointments.id]
  recorded_by uuid [ref: > users.id]
  tooth_number varchar [not null, note: 'ترقيم FDI']
  condition varchar [not null]
  treatment_status varchar [note: 'planned, in_progress, completed']
  notes text
  created_at timestamp [default: `now()`]
}

Table services {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  name_ar varchar [not null]
  name_en varchar
  default_price decimal
  is_active boolean [not null, default: true]
}

Table invoices {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  patient_id uuid [not null, ref: > patients.id]
  appointment_id uuid [ref: > appointments.id]
  created_by uuid [ref: > users.id]
  total_amount decimal [not null]
  status varchar [not null, note: 'paid, unpaid, partial']
  created_at timestamp [default: `now()`]
}

Table invoice_items {
  id uuid [pk]
  invoice_id uuid [not null, ref: > invoices.id]
  service_id uuid [ref: > services.id]
  description varchar
  price decimal [not null]
  quantity int [not null, default: 1]
}

Table xray_attachments {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  patient_id uuid [not null, ref: > patients.id]
  appointment_id uuid [ref: > appointments.id]
  file_url varchar [not null]
  file_type varchar
  uploaded_by uuid [ref: > users.id]
  created_at timestamp [default: `now()`]
}
