                            "raw": "{\n    \"email\": \"doctor@smileclinic.com\",\n    \"password\": \"password\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "if (pm.response.code === 200) {",
                                    "    const body = pm.response.json();",
                                    "    const payload = body.data || body;",
                                    "    const token = payload.access_token || payload.token || (payload.user && payload.user.token);",
                                    "    if (token) pm.environment.set('token', token);",
                                    "    // Also try to capture the logged-in user's id for use as doctor_id in appointments",
                                    "    const user = payload.user || (body.data && body.data.user);",
                                    "    if (user && user.id) pm.environment.set('doctor_id', user.id);",
                                    "}",
                                    "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
                                ]
                            }
                        }
                    ]
